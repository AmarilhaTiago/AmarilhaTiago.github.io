---
import { formatPeriod } from '../data/format';
import { getLocale, type Lang } from '../i18n';
import SectionTitle from './SectionTitle.astro';

interface Props {
  lang: Lang;
}

const { dict, profile } = getLocale(Astro.props.lang);
---

<section class="pt-14">
  <SectionTitle id={dict.anchors.experience} label={dict.sections.experience} />
  <ol class="ml-1 border-l border-border pl-5">
    {
      profile.experience.map((job) => (
        <li class="relative mb-6 last:mb-0">
          <span
            aria-hidden="true"
            class="absolute top-2 -left-[26px] h-2.5 w-2.5 rounded-full border-2 border-accent bg-bg"
          />
          <p class="font-semibold">{job.company.value}</p>
          <p>{job.role.value}</p>
          <p class="font-mono text-sm text-muted">{formatPeriod(job.period.value, dict.period)}</p>
          {job.note && <p class="mt-1 text-sm text-muted">{job.note.value}</p>}
        </li>
      ))
    }
  </ol>
</section>
