---
import { cvLink } from '../data/cv';
import { getLocale, type Lang } from '../i18n';
import SectionTitle from './SectionTitle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { dict, profile } = getLocale(lang);
const { contact } = profile;
const cvPt = cvLink('pt');
const cvEn = cvLink('en');
// Display text comes from the data, not from literals in the markup.
const githubLabel = contact.github.value.replace('https://', '');
const linkedinLabel = new URL(contact.linkedin.value).pathname.split('/').pop();
---

<section class="pt-14">
  <SectionTitle id={dict.anchors.links} label={dict.sections.links} />
  <ul class="grid gap-2 font-mono text-[15px]">
    <li>
      <span class="inline-block min-w-[11ch] text-muted">{dict.links.github}</span>
      <a href={contact.github.value}>{githubLabel}</a>
    </li>
    <li>
      <span class="inline-block min-w-[11ch] text-muted">{dict.links.linkedin}</span>
      <a href={contact.linkedin.value}>{linkedinLabel}</a>
    </li>
    <li>
      <span class="inline-block min-w-[11ch] text-muted">{dict.links.email}</span>
      <a href={`mailto:${contact.email.value}`}>{contact.email.value}</a>
    </li>
    <li>
      <span class="inline-block min-w-[11ch] text-muted">{dict.links.whatsapp}</span>
      <a href={contact.whatsappUrl.value}>{contact.whatsappDisplay.value}</a>
    </li>
    <li>
      <span class="inline-block min-w-[11ch] text-muted">{dict.links.cv}</span>
      <a
        href={cvPt.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${dict.links.cv} PT ${dict.nav.newTab}`}>PT</a
      >
      · <a
        href={cvEn.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${dict.links.cv} EN${cvEn.suffix} ${dict.nav.newTab}`}>EN{cvEn.suffix}</a
      >
    </li>
  </ul>
</section>
