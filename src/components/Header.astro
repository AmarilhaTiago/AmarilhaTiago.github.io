---
import { getLocale, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { dict } = getLocale(lang);
const selector = [
  { code: 'pt', href: '/' },
  { code: 'en', href: '/en/' },
];
---

<a
  href="#top"
  class="sr-only rounded-md bg-accent px-4 py-2 font-semibold text-on-accent no-underline focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-20"
>
  {dict.nav.skip}
</a>
<header class="sticky top-0 z-10 border-b border-border bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4 font-mono text-sm">
    <a href="#top" class="font-bold text-fg no-underline">
      ~/tiago<span
        aria-hidden="true"
        class="ml-0.5 inline-block h-[1.05em] w-[0.6ch] animate-blink bg-accent align-text-bottom"
      ></span>
    </a>
    <div class="flex items-center gap-2">
      <!-- Hidden until the script runs, so the page works without JavaScript. -->
      <button
        type="button"
        id="copy-link"
        hidden
        data-copied={dict.nav.copied}
        class="cursor-pointer rounded-md border border-border px-2.5 py-1 text-muted hover:border-muted hover:text-fg"
      >
        {dict.nav.copyLink}
      </button>
      <nav aria-label={dict.nav.language} class="flex gap-1">
        {
          selector.map((item) => (
            <a
              href={item.href}
              hreflang={item.code}
              aria-current={item.code === lang ? 'true' : undefined}
              class:list={[
                'rounded-md border px-2.5 py-1 no-underline',
                item.code === lang
                  ? 'border-accent text-accent'
                  : 'border-border text-muted hover:border-muted hover:text-fg',
              ]}
            >
              {item.code}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('copy-link');
  if (button instanceof HTMLButtonElement && navigator.clipboard) {
    const label = button.textContent;
    button.hidden = false;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      button.textContent = button.dataset.copied ?? label;
      setTimeout(() => (button.textContent = label), 1500);
    });
  }
</script>
