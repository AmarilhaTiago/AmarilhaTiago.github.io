---
import { pt } from '../i18n/pt';
---

<header class="sticky top-0 z-10 border-b border-border bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4 font-mono text-sm">
    <a href="#top" class="font-bold text-fg no-underline">
      ~/tiago<span
        aria-hidden="true"
        class="ml-0.5 inline-block h-[1.05em] w-[0.6ch] animate-blink bg-accent align-text-bottom"
      ></span>
    </a>
    <div class="flex items-center gap-2">
      <!-- Hidden until the script runs, so the page works without JavaScript. -->
      <button
        type="button"
        id="copy-link"
        hidden
        data-copied={pt.nav.copied}
        class="cursor-pointer rounded-md border border-border px-2.5 py-1 text-muted hover:border-muted hover:text-fg"
      >
        {pt.nav.copyLink}
      </button>
      <nav aria-label={pt.nav.language} class="flex gap-1">
        <a
          href="/"
          aria-current="true"
          class="rounded-md border border-accent px-2.5 py-1 text-accent no-underline"
        >
          pt
        </a>
        <!-- The English page arrives in card #12; until then this is not a link. -->
        <span
          aria-disabled="true"
          class="rounded-md border border-border px-2.5 py-1 text-muted opacity-60"
        >
          en
        </span>
      </nav>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('copy-link');
  if (button instanceof HTMLButtonElement && navigator.clipboard) {
    const label = button.textContent;
    button.hidden = false;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      button.textContent = button.dataset.copied ?? label;
      setTimeout(() => (button.textContent = label), 1500);
    });
  }
</script>
