---
import { getLocale, type Lang } from '../i18n';
import SectionTitle from './SectionTitle.astro';

interface Props {
  lang: Lang;
}

const { dict, profile } = getLocale(Astro.props.lang);
---

<section class="pt-14">
  <SectionTitle id={dict.anchors.about} label={dict.sections.about} />
  <p>{profile.about.value}</p>
</section>
